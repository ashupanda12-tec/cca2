# ── SAM / Lambda build artefacts ──────────────────────────────────────────────
# Generated by `sam build` — contains full dependency packages (boto3, etc.)
# Can be hundreds of MB. Rebuild with `sam build` before deploying.
.aws-sam/
samconfig.toml

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
dist/
build/
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── AWS credentials (never commit these) ─────────────────────────────────────
.aws/
credentials
*.pem
*.ppk

# ── IDE / OS artefacts ────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── Artist image cache ────────────────────────────────────────────────────────
# Downloaded locally by upload_images_to_s3.py then pushed to S3.
# No need to version-control these — re-run the script to regenerate.
data/images/

# ── Local test / scratch files ────────────────────────────────────────────────
scratch/
tmp/
